{
  "info": {
    "_postman_id": "techpulse-rbac-engine-v2",
    "name": "Dynamic RBAC Authorization Engine API",
    "description": "Postman Collection for Dynamic RBAC Authorization Engine assignment testing and demonstration using HTTP Basic Authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Roles Management (Role: ADMIN)",
      "item": [
        {
          "name": "POST /roles - Create Role (Admin)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "admin", "type": "string" },
                { "key": "password", "value": "admin123", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"OPERATOR\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/roles",
              "host": ["{{baseUrl}}"],
              "path": ["roles"]
            }
          }
        },
        {
          "name": "POST /roles - Create Role as User (Forbidden 403)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "user", "type": "string" },
                { "key": "password", "value": "user123", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"UNAUTHORIZED_ROLE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/roles",
              "host": ["{{baseUrl}}"],
              "path": ["roles"]
            }
          }
        },
        {
          "name": "GET /roles - List All Roles",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "admin", "type": "string" },
                { "key": "password", "value": "admin123", "type": "string" }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/roles",
              "host": ["{{baseUrl}}"],
              "path": ["roles"]
            }
          }
        },
        {
          "name": "POST /roles/{roleId}/permissions/{permissionId} - Assign Permission to Role",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "admin", "type": "string" },
                { "key": "password", "value": "admin123", "type": "string" }
              ]
            },
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/roles/2/permissions/1",
              "host": ["{{baseUrl}}"],
              "path": ["roles", "2", "permissions", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Permissions Management (Role: ADMIN)",
      "item": [
        {
          "name": "POST /permissions - Create Permission (Admin)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "admin", "type": "string" },
                { "key": "password", "value": "admin123", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"AUDIT_LOG_EXPORT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/permissions",
              "host": ["{{baseUrl}}"],
              "path": ["permissions"]
            }
          }
        },
        {
          "name": "GET /permissions - List All Permissions",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "admin", "type": "string" },
                { "key": "password", "value": "admin123", "type": "string" }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/permissions",
              "host": ["{{baseUrl}}"],
              "path": ["permissions"]
            }
          }
        }
      ]
    },
    {
      "name": "3. User-Role Assignment (Role: ADMIN)",
      "item": [
        {
          "name": "POST /users/{userId}/roles/{roleId} - Assign Role to User",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "admin", "type": "string" },
                { "key": "password", "value": "admin123", "type": "string" }
              ]
            },
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/users/3/roles/2",
              "host": ["{{baseUrl}}"],
              "path": ["users", "3", "roles", "2"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Secure Resource (Role: USER)",
      "item": [
        {
          "name": "GET /secure-data - Access as USER (200 OK)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "user", "type": "string" },
                { "key": "password", "value": "user123", "type": "string" }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/secure-data",
              "host": ["{{baseUrl}}"],
              "path": ["secure-data"]
            }
          }
        },
        {
          "name": "GET /secure-data - Access as GUEST (Forbidden 403)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "guest", "type": "string" },
                { "key": "password", "value": "guest123", "type": "string" }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/secure-data",
              "host": ["{{baseUrl}}"],
              "path": ["secure-data"]
            }
          }
        }
      ]
    }
  ]
}
