{
  "info": {
    "_postman_id": "techpulse-rbac-engine-v1",
    "name": "Dynamic RBAC Authorization Engine API",
    "description": "Postman Collection for Dynamic RBAC Authorization Engine assignment testing and demonstration.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "1. Login as Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "2. Login as Standard User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user\",\n  \"password\": \"user123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "3. Register New User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"john_doe\",\n  \"password\": \"password123\",\n  \"email\": \"john@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        }
      ]
    },
    {
      "name": "Roles Management (Requires ROLE_CREATE / ROLE_READ)",
      "item": [
        {
          "name": "Create New Role (POST /roles)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "admin", "type": "string" },
                { "key": "password", "value": "admin123", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"SUPPORT_SPECIALIST\",\n  \"description\": \"Handles customer inquiries\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/roles",
              "host": ["{{baseUrl}}"],
              "path": ["roles"]
            }
          }
        },
        {
          "name": "Get All Roles (GET /roles)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "admin", "type": "string" },
                { "key": "password", "value": "admin123", "type": "string" }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/roles",
              "host": ["{{baseUrl}}"],
              "path": ["roles"]
            }
          }
        },
        {
          "name": "Assign Permission to Role (POST /roles/{roleId}/permissions/{permissionId})",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "admin", "type": "string" },
                { "key": "password", "value": "admin123", "type": "string" }
              ]
            },
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/roles/2/permissions/1",
              "host": ["{{baseUrl}}"],
              "path": ["roles", "2", "permissions", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Permissions Management (Requires PERMISSION_CREATE / PERMISSION_READ)",
      "item": [
        {
          "name": "Create New Permission (POST /permissions)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "admin", "type": "string" },
                { "key": "password", "value": "admin123", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"REPORT_EXPORT\",\n  \"description\": \"Allows exporting financial and audit reports\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/permissions",
              "host": ["{{baseUrl}}"],
              "path": ["permissions"]
            }
          }
        },
        {
          "name": "Get All Permissions (GET /permissions)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "admin", "type": "string" },
                { "key": "password", "value": "admin123", "type": "string" }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/permissions",
              "host": ["{{baseUrl}}"],
              "path": ["permissions"]
            }
          }
        }
      ]
    },
    {
      "name": "User-Role Assignment (Requires USER_ROLE_ASSIGN)",
      "item": [
        {
          "name": "Assign Role to User (POST /users/{userId}/roles/{roleId})",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "admin", "type": "string" },
                { "key": "password", "value": "admin123", "type": "string" }
              ]
            },
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/users/2/roles/1",
              "host": ["{{baseUrl}}"],
              "path": ["users", "2", "roles", "1"]
            }
          }
        },
        {
          "name": "Get Current User Profile & Dynamic Permissions (GET /users/me)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "user", "type": "string" },
                { "key": "password", "value": "user123", "type": "string" }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Secured Resource (Requires SECURE_DATA_READ)",
      "item": [
        {
          "name": "Access Secure Data as USER (Success 200 OK)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "user", "type": "string" },
                { "key": "password", "value": "user123", "type": "string" }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/secure-data",
              "host": ["{{baseUrl}}"],
              "path": ["secure-data"]
            }
          }
        },
        {
          "name": "Access Secure Data as GUEST (Forbidden 403)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "guest", "type": "string" },
                { "key": "password", "value": "guest123", "type": "string" }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/secure-data",
              "host": ["{{baseUrl}}"],
              "path": ["secure-data"]
            }
          }
        }
      ]
    }
  ]
}
